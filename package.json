{
  "name": "mydashie",
  "productName": "MyDashie",
  "version": "0.1.4",
  "description": "Self-service reporting AI. Describe a dashboard, get it built, keep it fresh on a schedule.",
  "author": "MyDashie",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "libs": "node scripts/copy-libs.mjs",
    "brand": "node scripts/gen-brand.mjs",
    "icons": "node scripts/make-icons.mjs",
    "smoke": "tsx --tsconfig tsconfig.node.json scripts/smoke-agent.ts",
    "package": "npm run build && electron-builder --mac --publish never",
    "package:all": "npm run build && electron-builder --mac --win",
    "eval": "tsx --tsconfig tsconfig.node.json evals/run.ts",
    "package:community": "DASH_EDITION=community npm run build && electron-builder --mac --publish never -c.directories.output=release-community"
  },
  "dependencies": {
    "@composio/core": "^0.22.0",
    "@duckdb/node-api": "1.5.6-r.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@supabase/supabase-js": "^2.117.3",
    "croner": "^10.0.1",
    "electron-updater": "^6.8.9",
    "openai": "^7.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@google/genai": "^2.28.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "chart.js": "^4.5.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "echarts": "^6.1.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "motion": "^14.1.0",
    "playwright-core": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TreyBros/mydashie.git"
  },
  "homepage": "https://mydashie.com"
}
